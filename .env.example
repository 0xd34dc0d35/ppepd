# Development: open the SSH tunnel with npm run db:tunnel before npm run dev.
NUXT_PUBLIC_LOCAL_MANAGEMENT=true
NUXT_MANAGEMENT_STORAGE=postgres
# Keep actual credentials in .env only. This is a template, not a working password.
NUXT_MANAGEMENT_DATABASE_URL=postgresql://ppepd_dev:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:15434/ppepd_dev
NUXT_MANAGEMENT_SCHEMA=ppepd_management
